# Copy to .env.local (git-ignored) for local development. On Vercel, set the same names as project env vars.
DATABASE_URL=postgres://postgres:dev@localhost:5432/demos
DB_SCHEMA=rentroll
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEMO_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Space-separated origins allowed to frame the demo. 127.0.0.1:* lets the e2e embed test frame it locally.
ALLOWED_FRAME_ANCESTORS=http://localhost:3012 http://127.0.0.1:*
PEERA_LAB_URL=http://localhost:3012
# At least 16 characters; Vercel Cron sends it as a bearer token to /api/cron/daily.
CRON_SECRET=replace-with-a-random-secret
# Required on Vercel (rate limits); leave unset locally.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
