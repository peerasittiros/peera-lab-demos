{
  "name": "stockline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3011",
    "build": "next build",
    "start": "next start -p 3011",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed/run.ts",
    "db:reset": "node --env-file-if-exists=.env.local --import tsx src/db/reset.ts"
  },
  "dependencies": {
    "@peera/config": "workspace:*",
    "@peera/db": "workspace:*",
    "@peera/demo-kit": "workspace:*",
    "@peera/i18n": "workspace:*",
    "@peera/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@peera/test-utils": "workspace:*",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
